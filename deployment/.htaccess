# ====================================================================
# MEHEDI 3D - ProFreeHost Apache Configuration (.htaccess)
# ====================================================================

Options -Indexes
ServerSignature Off

# 1. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 2. Block direct HTTP access to protected directories and configuration files
<FilesMatch "(^\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|tsconfig\.json|\.sql|\.log|\.md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Block execution of PHP and CGI scripts inside uploads directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent PHP execution in uploads
    RewriteRule ^uploads/.*\.php$ - [F,L]

    # API Routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/v1/(.*)$ backend/api/$1.php [L,QSA]

    # SPA Routing: Send all non-file requests to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# 4. Gzip / Deflate Compression for Three.js 3D & Static Bundles
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/x-font-ttf font/opentype
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 5. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
</IfModule>
